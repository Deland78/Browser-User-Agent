# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Optional: Your site URL and app name for OpenRouter credits/rankings
# See: https://openrouter.ai/docs#oauth
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Browser-Agent-Chat

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIRECTORY=backend/logs

# Browser Settings
BROWSER_HEADLESS=false

# Database (SQLite will auto-create on first run)
DATABASE_URL=sqlite+aiosqlite:///backend/browser_agent.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (for local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
